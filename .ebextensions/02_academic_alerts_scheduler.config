files:
  "/etc/cron.d/academic_alerts":
    mode: "000644"
    owner: root
    group: root
    content: |
      SHELL=/bin/bash
      PATH=/usr/local/bin:/usr/bin:/bin
      0 23 * * * root /bin/bash /var/app/current/scripts/run_academic_alerts.sh >> /var/log/academic_alerts_cron.log 2>&1

commands:
  01_make_alerts_script_executable:
    command: "chmod +x /var/app/current/scripts/run_academic_alerts.sh"
  02_restart_crond:
    command: "service crond restart || systemctl restart crond"
